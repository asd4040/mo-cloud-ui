{
  "name": "@mocloud/frontend-sdk",
  "version": "0.2.0",
  "packageManager": "pnpm@11.3.0",
  "description": "Lightweight JavaScript Bridge client for MoCloud embedded apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "engines": {
    "node": ">=20 <23",
    "pnpm": ">=10 <12"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~5.7.0"
  }
}
