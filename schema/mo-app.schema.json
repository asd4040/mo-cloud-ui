{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asd4040/mo-cloud-ui/schema/mo-app.schema.json",
  "title": "MoCloud App Manifest",
  "description": "MoCloud 嵌入式应用声明文件。",
  "type": "object",
  "required": ["name", "audience", "category", "capabilities", "surfaces", "embed"],
  "properties": {
    "$schema": { "type": "string", "description": "编辑器使用的 Schema 地址。" },
    "name": { "type": "string", "minLength": 1, "description": "应用显示名称。" },
    "audience": { "type": "string", "description": "目标用户群体，例如 c。" },
    "category": { "type": "string", "description": "应用市场分类，例如 shopping。" },
    "description": { "type": "string", "description": "应用功能简介。" },
    "capabilities": {
      "type": "array",
      "description": "应用可以通过宿主调用的能力。",
      "items": { "$ref": "#/$defs/capability" }
    },
    "surfaces": {
      "type": "array",
      "description": "应用可以渲染的界面。",
      "items": {
        "type": "object",
        "required": ["id", "type", "schema"],
        "properties": {
          "id": { "type": "string", "description": "界面唯一 ID。" },
          "type": { "type": "string", "description": "界面类型，例如 embedded_view。" },
          "schema": { "type": "string", "description": "界面数据协议版本。" }
        },
        "additionalProperties": true
      }
    },
    "embed": {
      "type": "object",
      "required": ["entry_type", "bundle", "permissions"],
      "properties": {
        "entry_type": { "type": "string", "description": "嵌入视图打开方式。" },
        "bundle": { "type": "string", "description": "前端资源地址或上传占位符。" },
        "permissions": {
          "type": "array",
          "description": "应用申请的 capability 和 UI 权限。",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "network": {
      "type": "object",
      "properties": {
        "connect_src": {
          "type": "array",
          "description": "允许连接的外部域名列表。",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "required": ["id", "name", "type", "transport", "input_schema", "output_schema"],
      "properties": {
        "id": { "type": "string", "description": "能力唯一 ID，需与 SDK 调用名称一致。" },
        "name": { "type": "string", "description": "能力显示名称。" },
        "type": { "type": "string", "description": "能力类型，例如 tool。" },
        "description": { "type": "string", "description": "能力用途说明。" },
        "transport": {
          "type": "object",
          "required": ["type", "topology", "endpoint", "method"],
          "properties": {
            "type": { "type": "string", "description": "传输类型，例如 http。" },
            "topology": { "type": "string", "description": "网络拓扑，例如 public。" },
            "endpoint": { "type": "string", "description": "服务端接口地址。" },
            "method": { "type": "string", "description": "HTTP 方法。" }
          },
          "additionalProperties": true
        },
        "input_schema": { "type": "object", "description": "输入参数 JSON Schema。" },
        "output_schema": { "type": "object", "description": "输出结果 JSON Schema。" },
        "runtime": {
          "type": "object",
          "properties": {
            "timeout_ms": { "type": "integer", "minimum": 1, "description": "超时时间（毫秒）。" },
            "side_effect": { "type": "boolean", "description": "是否会修改外部数据。" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
